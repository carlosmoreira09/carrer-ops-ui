# career-ops — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# NEVER put real keys in this file — it is committed to git. Put real values
# only in .env (which is gitignored).

# ── AI provider selection ────────────────────────────────────────────────────
# openai (default for the web UI) or gemini
AI_ANALYSIS_PROVIDER=openai

# ── OpenAI (used by the web UI + openai-eval.mjs) ────────────────────────────
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Gemini (used by gemini-eval.mjs) ─────────────────────────────────────────
# Free API key: https://aistudio.google.com/apikey
# Free tier: 15 RPM / 1M tokens/day with gemini-2.5-flash (no billing needed)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Other integrations (add your own below) ──────────────────────────────────
# ANTHROPIC_API_KEY=your_anthropic_key_here   # For Claude-based workflows
